# ============================================================
# AICSS Backend Configuration
# ============================================================

# Server
AICSS_HOST=0.0.0.0
AICSS_PORT=8000
AICSS_RELOAD=true

# Device: "cuda" for GPU acceleration, "cpu" for CPU only
AICSS_DEVICE=cuda

# HuggingFace token (required for some gated models, optional otherwise)
AICSS_HF_TOKEN=

# Model choices
AICSS_DEPTH_MODEL=depth-anything/Depth-Anything-V2-Large-hf
AICSS_GROUNDING_DINO_MODEL=IDEA-Research/grounding-dino-base
AICSS_SAM2_MODEL_SIZE=vit_l
AICSS_VLM_MODEL=Qwen/Qwen3-VL-4B-Instruct

# Segmentation prompt (dot-separated class names)
AICSS_SEGMENTATION_PROMPT=person.car.building.tree.lamp.door.window.chair.table.road.sky.mountain.water.grass.flower

# Lazy loading: "true" loads models on first use, "false" loads all at startup
AICSS_LAZY_LOAD=true

# LLM for script parsing
AICSS_LLM_BASE_URL=http://localhost:8080/v1
AICSS_LLM_MODEL=

# Image generation (optional, for future use)
AICSS_IMAGE_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0

# Video generation provider: "dashscope", "local_wan", or "svd"
AICSS_VIDEO_PROVIDER=dashscope
AICSS_DASHSCOPE_API_KEY=

# Inpainting model timeout (seconds)
AICSS_INPAINT_TIMEOUT=120
