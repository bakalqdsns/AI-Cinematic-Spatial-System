# AICSS Backend Environment Variables
# Copy this file to .env and fill in your actual values

# DashScope API Keys (get from https://dashscope.console.aliyun.com/)
AICSS_DASHSCOPE_LLM_API_KEY=your_llm_api_key_here
AICSS_DASHSCOPE_VLM_API_KEY=your_vlm_api_key_here
AICSS_DASHSCOPE_IMAGE_API_KEY=your_image_api_key_here
AICSS_DASHSCOPE_VIDEO_API_KEY=your_video_api_key_here
